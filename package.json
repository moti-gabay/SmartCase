    "db:audit": "tsx scripts/case-audit.ts",
    "db:studio": "prisma studio",
    "mcp:serve": "tsx scripts/mcp/server.ts",
    "slack-daemon": "node scripts/slack-daemon.js",
    "telegram-daemon": "tsx scripts/telegram/daemon.ts",
