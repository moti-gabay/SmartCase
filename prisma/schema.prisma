generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection – used by Prisma Client at runtime
  directUrl = env("DIRECT_URL")     // direct connection – used by prisma migrate only
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SUPERVISOR
  AGENT
}

enum CaseStatus {
  NEW_INTAKE
  GATHERING_DOCUMENTS
  PENDING_AI_REVIEW
  READY_FOR_SUBMISSION
  SUBMITTED
  AWAITING_DECISION
  APPROVED
  REJECTED
  APPEAL_IN_PROGRESS
  CLOSED
}

enum CaseType {
  DISABILITY_PENSION
  GENERAL_DISABILITY_ALLOWANCE
  MOBILITY_ALLOWANCE
  INCOME_SUPPORT
  LONG_TERM_CARE
  SURVIVORS_BENEFIT
  WORK_ACCIDENT
  OCCUPATIONAL_DISEASE
  APPEAL
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentStatus {
  MISSING
  UPLOADED_PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentType {
  NATIONAL_ID
  MEDICAL_REPORT
  PSYCHIATRIC_EVALUATION
  SALARY_SLIP
  EMPLOYER_CONFIRMATION
  BANK_STATEMENT
  HOSPITALIZATION_SUMMARY
  SPECIALIST_REFERRAL
  PRESCRIPTION
  LAB_RESULTS
  INCOME_TAX_RETURN
  SPOUSE_INCOME_PROOF
  DISABILITY_CERTIFICATE
  PHOTOGRAPH
  AUTHORITY_DECISION_LETTER
  APPEAL_LETTER
  POWER_OF_ATTORNEY
  OTHER
}

enum NoteType {
  INTERNAL
  CALL_LOG
  EMAIL
  MEETING
  AUTHORITY_CONTACT
  SYSTEM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  RETIRED
  STUDENT
  UNABLE_TO_WORK
}

// ─── User (Agents / Supervisors / Admins) ─────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true)
  avatarUrl    String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCases  Case[]              @relation("AssignedAgent")
  createdCases   Case[]              @relation("CaseCreator")
  notes          Note[]
  tasks          Task[]              @relation("TaskAssignee")
  createdTasks   Task[]              @relation("TaskCreator")
  statusChanges  CaseStatusHistory[]
  uploadedDocs   Document[]          @relation("DocumentUploader")
  reviewedDocs   Document[]          @relation("DocumentReviewer")
  auditLogs      AuditLog[]

  @@map("users")
}

// ─── Client (Person Being Helped) ─────────────────────────────────────────────

model Client {
  id               String           @id @default(cuid())
  fullName         String
  nationalId       String           @unique
  dateOfBirth      DateTime
  gender           Gender
  phone            String
  email            String?
  addressStreet    String?
  addressCity      String?
  addressZip       String?
  employmentStatus EmploymentStatus @default(UNEMPLOYED)
  employer         String?
  monthlyIncome    Decimal?         @db.Decimal(10, 2)
  spouseIncome     Decimal?         @db.Decimal(10, 2)
  spouseName       String?
  spouseNationalId String?
  primaryCondition String?
  icdCode          String?
  recognizedPercentage Int?
  diagnosisDate    DateTime?
  treatingPhysician String?
  isActive         Boolean          @default(true)
  internalNotes    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  cases Case[]

  @@map("clients")
}

// ─── Case ─────────────────────────────────────────────────────────────────────

model Case {
  id                       String     @id @default(cuid())
  caseNumber               String     @unique
  clientId                 String
  assignedAgentId          String?
  createdById              String
  caseType                 CaseType
  status                   CaseStatus @default(NEW_INTAKE)
  priority                 Priority   @default(MEDIUM)
  authorityReferenceNumber String?
  submissionDate           DateTime?
  submissionDeadline       DateTime?
  decisionDate             DateTime?
  decisionDescription      String?
  claimedPercentage        Int?
  claimDescription         String?
  hasMissingDocuments      Boolean    @default(true)
  isOverdue                Boolean    @default(false)
  lastContactDate          DateTime?
  nextFollowUpDate         DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  closedAt                 DateTime?

  client        Client              @relation(fields: [clientId], references: [id])
  assignedAgent User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  createdBy     User                @relation("CaseCreator", fields: [createdById], references: [id])
  documents     Document[]
  notes         Note[]
  tasks         Task[]
  statusHistory CaseStatusHistory[]
  checklist     CaseChecklist[]

  @@index([clientId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@map("cases")
}

// ─── Case Status History ───────────────────────────────────────────────────────

model CaseStatusHistory {
  id             String      @id @default(cuid())
  caseId         String
  changedById    String
  previousStatus CaseStatus?
  newStatus      CaseStatus
  reason         String?
  createdAt      DateTime    @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([caseId])
  @@map("case_status_history")
}

// ─── Document ─────────────────────────────────────────────────────────────────

model Document {
  id           String         @id @default(cuid())
  caseId       String
  uploadedById String?
  reviewedById String?
  documentType DocumentType
  displayName  String
  storageKey   String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  status       DocumentStatus @default(MISSING)
  expiryDate   DateTime?
  issueDate    DateTime?
  aiSummary    String?        @db.Text
  aiValidation Json?
  isAiReviewed Boolean        @default(false)
  reviewNotes  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  case          Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy    User?           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  reviewedBy    User?           @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  checklistItem CaseChecklist[]

  @@index([caseId])
  @@index([status])
  @@map("documents")
}

// ─── Document Checklist Template ──────────────────────────────────────────────

model DocumentChecklistTemplate {
  id             String       @id @default(cuid())
  caseType       CaseType
  documentType   DocumentType
  displayName    String
  description    String?
  isMandatory    Boolean      @default(true)
  validityMonths Int?
  sortOrder      Int          @default(0)

  checklistItems CaseChecklist[]

  @@unique([caseType, documentType])
  @@map("document_checklist_templates")
}

// ─── Case Checklist ───────────────────────────────────────────────────────────

model CaseChecklist {
  id         String         @id @default(cuid())
  caseId     String
  templateId String
  documentId String?
  status     DocumentStatus @default(MISSING)
  notes      String?
  updatedAt  DateTime       @updatedAt

  case     Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template DocumentChecklistTemplate @relation(fields: [templateId], references: [id])
  document Document?                 @relation(fields: [documentId], references: [id])

  @@unique([caseId, templateId])
  @@map("case_checklists")
}

// ─── Note ─────────────────────────────────────────────────────────────────────

model Note {
  id           String   @id @default(cuid())
  caseId       String
  authorId     String
  type         NoteType @default(INTERNAL)
  content      String   @db.Text
  followUpDate DateTime?
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([caseId])
  @@map("notes")
}

// ─── Task ─────────────────────────────────────────────────────────────────────

model Task {
  id           String     @id @default(cuid())
  caseId       String
  assignedToId String?
  createdById  String
  title        String
  description  String?
  dueDate      DateTime?
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User  @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([caseId])
  @@index([assignedToId])
  @@index([dueDate])
  @@map("tasks")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
