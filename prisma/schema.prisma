generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7 the url field is no longer set here.
  // • CLI/migrations: url is read from prisma.config.ts → datasource.url
  // • Runtime: url is passed via PrismaPg adapter in src/lib/prisma.ts
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SUPERVISOR
  AGENT
  CLIENT
}

// Account lifecycle for staff/agents. Source of truth for login authorization —
// see the `authorize`/`jwt` gate in auth.ts. New self-registrations default to
// PENDING_APPROVAL until an admin approves them. Supersedes the legacy `isActive`
// boolean (kept temporarily for backward compat, no longer read by auth).
enum UserStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
}

enum CaseStatus {
  NEW_INTAKE
  GATHERING_DOCUMENTS
  PENDING_AI_REVIEW
  READY_FOR_SUBMISSION
  SUBMITTED
  AWAITING_DECISION
  APPROVED
  REJECTED
  APPEAL_IN_PROGRESS
  CLOSED
}

enum CaseType {
  DISABILITY_PENSION
  GENERAL_DISABILITY_ALLOWANCE
  MOBILITY_ALLOWANCE
  INCOME_SUPPORT
  LONG_TERM_CARE
  SURVIVORS_BENEFIT
  WORK_ACCIDENT
  OCCUPATIONAL_DISEASE
  APPEAL
  CONVERSION
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentStatus {
  MISSING
  PENDING_UPLOAD
  UPLOADED_PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentType {
  NATIONAL_ID
  MEDICAL_REPORT
  PSYCHIATRIC_EVALUATION
  SALARY_SLIP
  EMPLOYER_CONFIRMATION
  BANK_STATEMENT
  HOSPITALIZATION_SUMMARY
  SPECIALIST_REFERRAL
  PRESCRIPTION
  LAB_RESULTS
  INCOME_TAX_RETURN
  SPOUSE_INCOME_PROOF
  DISABILITY_CERTIFICATE
  PHOTOGRAPH
  AUTHORITY_DECISION_LETTER
  APPEAL_LETTER
  POWER_OF_ATTORNEY
  RABBI_LETTER
  COMMUNITY_LETTER
  FAMILY_PHOTO
  OTHER
}

enum NoteType {
  INTERNAL
  CALL_LOG
  EMAIL
  MEETING
  AUTHORITY_CONTACT
  SYSTEM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  RETIRED
  STUDENT
  UNABLE_TO_WORK
}

enum LetterType {
  CLAIM_REQUEST
  APPEAL
  SEVERITY_INCREASE
  MEDICAL_COMMITTEE
  AUTHORITY_INQUIRY
  COVER_LETTER
  OTHER
}

// Structured, append-only activity feed for a case (Smart Activity Timeline).
// Written by logCaseActivity() inside the mutating action's own transaction.
enum ActivityType {
  CASE_CREATED
  DOCUMENT_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  STEP_CHANGED
  AI_CALL_SUMMARY
}

// Client-portal journey state machine (Phase 5 wizard). Ordered; transitions are
// validated server-side in src/lib/portal/journey.ts — the client can never name
// a target step, only request "advance" and the server verifies completion.
enum CaseStep {
  WELCOME            // screen 1 — zero input
  PROCESS_OVERVIEW   // screen 2 — zero input
  WIZARD_PERSONAL    // contact details slice
  WIZARD_FAMILY      // spouse/children slice
  WIZARD_BACKGROUND  // community/rabbi/court slice
  PERSONAL_STORY     // free-text story (audio module later)
  WIZARD_REFERENCES  // structured recommenders (name, phone, role)
  PENDING_DOCS       // mandatory checklist uploads
  SCHEDULE_MEETING   // staff-driven until the Smart Scheduling module lands
  TRACKING           // terminal passive milestone view
}

// Server-side transcription state of a PERSONAL_STORY audio recording. Null (no
// value) means "no audio" — the field only carries a value once a recording is
// confirmed. Not a labeled status chip in the portal, so no entry in
// src/lib/constants.ts; the backoffice renders it from the enum directly.
enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// AI assistant chat message author. Internal to the chat feature — not rendered
// as a labeled status chip, so it has no entry in src/lib/constants.ts.
enum ChatRole {
  USER
  ASSISTANT
}

// ─── User (Agents / Supervisors / Admins) ─────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole   @default(AGENT)
  status       UserStatus @default(PENDING_APPROVAL)
  isActive     Boolean    @default(true)
  avatarUrl    String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedCases  Case[]              @relation("AssignedAgent")
  createdCases   Case[]              @relation("CaseCreator")
  notes          Note[]
  tasks          Task[]              @relation("TaskAssignee")
  createdTasks   Task[]              @relation("TaskCreator")
  statusChanges  CaseStatusHistory[]
  uploadedDocs   Document[]          @relation("DocumentUploader")
  reviewedDocs   Document[]          @relation("DocumentReviewer")
  auditLogs      AuditLog[]
  generatedLetters GeneratedLetter[] @relation("LetterAuthor")
  activities     CaseActivity[]
  conversations  Conversation[]

  @@index([status])
  @@map("users")
}

// ─── Client (Person Being Helped) ─────────────────────────────────────────────

model Client {
  id               String           @id @default(cuid())
  fullName         String
  nationalId       String           @unique
  dateOfBirth      DateTime
  gender           Gender
  phone            String
  email            String?
  // Persisted portal/communication language (PortalLocale: "he" | "en" | "fr").
  // A plain String, not a DB enum, so the locale set stays owned by the i18n
  // dictionary in src/lib/i18n/conversion-portal.ts — which already holds the
  // labels and direction map — instead of being split across a schema enum and
  // a second label table. Values are guarded by isPortalLocale() at every
  // boundary that reads or writes this column.
  locale           String           @default("he")
  addressStreet    String?
  addressCity      String?
  addressZip       String?
  employmentStatus EmploymentStatus @default(UNEMPLOYED)
  employer         String?
  monthlyIncome    Decimal?         @db.Decimal(10, 2)
  spouseIncome     Decimal?         @db.Decimal(10, 2)
  spouseName       String?
  spouseNationalId String?
  primaryCondition String?
  icdCode          String?
  recognizedPercentage Int?
  diagnosisDate    DateTime?
  treatingPhysician String?
  isActive         Boolean          @default(true)
  internalNotes    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  cases Case[]

  @@map("clients")
}

// ─── Case ─────────────────────────────────────────────────────────────────────

model Case {
  id                       String     @id @default(cuid())
  caseNumber               String     @unique
  clientId                 String
  assignedAgentId          String?
  createdById              String
  caseType                 CaseType
  status                   CaseStatus @default(NEW_INTAKE)
  priority                 Priority   @default(MEDIUM)
  authorityReferenceNumber String?
  submissionDate           DateTime?
  submissionDeadline       DateTime?
  decisionDate             DateTime?
  decisionDescription      String?
  claimedPercentage        Int?
  claimDescription         String?
  hasMissingDocuments      Boolean    @default(true)
  isOverdue                Boolean    @default(false)
  lastContactDate          DateTime?
  nextFollowUpDate         DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  closedAt                 DateTime?

  // Case tags (see src/types/case-tags.ts) — small, ad-hoc labels; no dedicated
  // table per human decision (see spec-case-tagging-ui.md).
  tags                     Json       @default("[]")

  // Public client-portal share link (see ConversionProfile). The token is a
  // high-entropy random bearer secret, not a field-level-encrypted value —
  // only its presence + expiry are checked, so encryption would add no
  // security here. Rotate (regenerate) to revoke a leaked link.
  clientPortalToken          String?   @unique
  clientPortalTokenExpiresAt DateTime?

  // Current step of the client's portal journey (Phase 5 wizard). Lives on Case
  // (not ConversionProfile) because the profile row is created lazily on first
  // portal submit, while the journey starts the moment the link is shared.
  portalStep CaseStep @default(WELCOME)

  client            Client              @relation(fields: [clientId], references: [id])
  assignedAgent     User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  createdBy         User                @relation("CaseCreator", fields: [createdById], references: [id])
  documents         Document[]
  notes             Note[]
  tasks             Task[]
  statusHistory     CaseStatusHistory[]
  checklist         CaseChecklist[]
  letters           GeneratedLetter[]
  conversionProfile ConversionProfile?
  activities        CaseActivity[]

  @@index([clientId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@map("cases")
}

// ─── Case Status History ───────────────────────────────────────────────────────

model CaseStatusHistory {
  id             String      @id @default(cuid())
  caseId         String
  changedById    String
  previousStatus CaseStatus?
  newStatus      CaseStatus
  reason         String?
  createdAt      DateTime    @default(now())

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([caseId])
  @@map("case_status_history")
}

// ─── Document ─────────────────────────────────────────────────────────────────

model Document {
  id           String         @id @default(cuid())
  caseId       String
  uploadedById String?
  reviewedById String?
  documentType DocumentType
  displayName  String
  storageKey   String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  fileData     Bytes?
  status       DocumentStatus @default(MISSING)
  expiryDate   DateTime?
  issueDate    DateTime?
  aiSummary    String?        @db.Text
  aiValidation Json?
  isAiReviewed Boolean        @default(false)
  reviewNotes  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  case          Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy    User?           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  reviewedBy    User?           @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  checklistItem CaseChecklist[]
  references    ConversionReference[]

  @@index([caseId])
  @@index([status])
  @@map("documents")
}

// ─── Document Checklist Template ──────────────────────────────────────────────

model DocumentChecklistTemplate {
  id             String       @id @default(cuid())
  caseType       CaseType
  documentType   DocumentType
  displayName    String
  description    String?
  isMandatory    Boolean      @default(true)
  validityMonths Int?
  sortOrder      Int          @default(0)

  checklistItems CaseChecklist[]

  @@unique([caseType, documentType])
  @@map("document_checklist_templates")
}

// ─── Case Checklist ───────────────────────────────────────────────────────────

model CaseChecklist {
  id         String         @id @default(cuid())
  caseId     String
  templateId String
  documentId String?
  status     DocumentStatus @default(MISSING)
  notes      String?
  updatedAt  DateTime       @updatedAt

  case     Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  template DocumentChecklistTemplate @relation(fields: [templateId], references: [id])
  document Document?                 @relation(fields: [documentId], references: [id])

  @@unique([caseId, templateId])
  @@map("case_checklists")
}

// ─── Note ─────────────────────────────────────────────────────────────────────

model Note {
  id           String   @id @default(cuid())
  caseId       String
  authorId     String
  type         NoteType @default(INTERNAL)
  content      String   @db.Text
  followUpDate DateTime?
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([caseId])
  @@map("notes")
}

// ─── Task ─────────────────────────────────────────────────────────────────────

model Task {
  id           String     @id @default(cuid())
  caseId       String
  assignedToId String?
  createdById  String
  title        String
  description  String?
  dueDate      DateTime?
  priority     Priority   @default(MEDIUM)
  status       TaskStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  case       Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User  @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([caseId])
  @@index([assignedToId])
  @@index([dueDate])
  @@map("tasks")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─── Case Activity (Smart Activity Timeline) ──────────────────────────────────

model CaseActivity {
  id          String       @id @default(cuid())
  caseId      String
  userId      String?
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  case Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([caseId])
  @@map("case_activities")
}

// ─── Generated Letter (AI drafts) ───────────────────────────────────────────────

model GeneratedLetter {
  id          String     @id @default(cuid())
  caseId      String
  createdById String?
  letterType  LetterType
  title       String
  content     String     @db.Text
  context     String?    @db.Text
  createdAt   DateTime   @default(now())

  case      Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LetterAuthor", fields: [createdById], references: [id])

  @@index([caseId])
  @@map("generated_letters")
}

// ─── Conversion (גיור) case metadata ────────────────────────────────────────────
// Case-type-specific profile, editable by the client through the public portal
// (identity fields on Client/Case itself remain staff-only / read-only there).

model ConversionProfile {
  id               String    @id @default(cuid())
  caseId           String    @unique
  spouseFullName   String?
  spouseNationalId String?
  spouseReligion   String?
  communityName    String?
  sponsoringRabbi  String?
  courtName        String?
  additionalNotes  String?   @db.Text
  personalStory    String?   @db.Text

  // PERSONAL_STORY audio alternative (Phase 5). storyAudioKey is the canonical
  // handle — the R2 object key; playback always goes through a short-lived
  // presigned GET derived from it. storyAudioUrl is the durable (still private,
  // signature-required) object URL, kept for staff tooling / audit trails.
  // Both null until a recording is confirmed; re-recording replaces them and
  // deletes the previous object.
  storyAudioKey            String?
  storyAudioUrl            String?
  storyTranscript          String?              @db.Text
  storyTranscriptionStatus TranscriptionStatus?

  submittedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case       Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  children   ConversionChild[]
  references ConversionReference[]

  @@map("conversion_profiles")
}

model ConversionChild {
  id                  String    @id @default(cuid())
  conversionProfileId String
  fullName            String
  dateOfBirth         DateTime?

  conversionProfile ConversionProfile @relation(fields: [conversionProfileId], references: [id], onDelete: Cascade)

  @@index([conversionProfileId])
  @@map("conversion_children")
}

// Recommenders vouching for the candidate (WIZARD_REFERENCES step). Client-owned
// rows: created/edited/removed from the public portal, so every mutation must
// re-derive the owning profile from the portal token — see
// src/app/api/public/conversion/[token]/references/route.ts.
model ConversionReference {
  id                  String   @id @default(cuid())
  conversionProfileId String
  fullName            String
  phone               String
  // Free text (e.g. "רב הקהילה") rather than an enum — the office has no fixed
  // taxonomy of recommender roles, and a wrong enum would block a real client.
  role                String
  // How the recommender knows the candidate; optional context for the office.
  relationship String?
  // Optional supporting letter. onDelete: SetNull — deleting the underlying
  // Document must never cascade away the recommender's contact details.
  documentId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversionProfile ConversionProfile @relation(fields: [conversionProfileId], references: [id], onDelete: Cascade)
  document          Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([conversionProfileId])
  @@map("conversion_references")
}

// ─── AI Assistant Chat (staff-only, read-only tools) ──────────────────────────
// One rolling conversation per user surfaced in the dashboard drawer; "שיחה
// חדשה" creates a fresh row (old rows kept, not listed). Tool results are never
// stored — only the final text plus a compact toolCalls audit trail.

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String? // first user message, truncated to 80 chars
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String   @db.Text // final text (markdown for assistant turns)
  toolCalls      Json? // assistant only: [{ name, args, ok, ms }] — args/status, never results
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
