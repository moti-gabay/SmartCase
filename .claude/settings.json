  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Session Initialization] Working branch: $(git branch --show-current)\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-summary.sh",
            "timeout": 15,
            "statusMessage": "Saving session summary..."
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-summary.sh",
            "timeout": 15,
            "statusMessage": "Saving failure summary..."
          }
        ]
      }
    ]
  }
}
