# ─────────────────────────────────────────────────────────────────────────────
# SmartCase – Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, add each variable via the Vercel Dashboard → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL / Prisma ───────────────────────────────────────────────────────
#
# Vercel serverless functions open a new DB connection on every invocation.
# A direct connection will exhaust PostgreSQL's connection limit quickly.
# Use a connection pooler (Supabase pooler port 6543, or Neon's pooled URL).
#
# OPTION A – Supabase
#   DATABASE_URL  → pooler (port 6543, Transaction mode)
#   DIRECT_URL    → direct (port 5432, used only by `prisma migrate`)
#
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# OPTION B – Neon (uncomment and replace Supabase lines above)
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.eu-central-1.aws.neon.tech/[db]?sslmode=require"
# DIRECT_URL="postgresql://[user]:[password]@[endpoint].eu-central-1.aws.neon.tech/[db]?sslmode=require"

# OPTION C – Local development (no pooler needed)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartcase_dev"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartcase_dev"


# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate a random secret:  openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-project.vercel.app"

# ── Google OAuth (Sign in with Google — linking-only) ─────────────────────────
# Google login is LINKING-ONLY: it authenticates the person, but access is
# granted only when the Google-verified email matches an existing APPROVED
# staff account (see the signIn gate in auth.ts). No account is auto-created.
# Create an OAuth 2.0 Client (type "Web application") in Google Cloud Console →
# APIs & Services → Credentials. Authorized redirect URI:
#   https://your-project.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (for local dev)
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."


# ── Google Gemini API ─────────────────────────────────────────────────────────
# Model: gemini-2.5-flash-lite. Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="..."


# ── Cloudflare R2 (Document Storage — zero egress fees) ────────────────────────
# S3-compatible, signed natively in-app (SigV4, region "auto").
# Endpoint: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Create an R2 bucket + API token (Object Read & Write) in the Cloudflare dashboard.
R2_ACCOUNT_ID="..."
R2_BUCKET="smartcase-documents"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."


# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
# Verified sender. Falls back to onboarding@resend.dev in dev if unset.
RESEND_FROM="SmartCase <notifications@your-domain.com>"


# ── Claude Code MCP (.mcp.json) ───────────────────────────────────────────────
# GitHub hosted MCP token — fine-grained PAT, repo scope.
# Create at: https://github.com/settings/personal-access-tokens
# (postgres MCP reuses DATABASE_URL above; playwright MCP needs no secret.)
GITHUB_PAT="github_pat_..."

# Slack MCP — @modelcontextprotocol/server-slack (archived/deprecated upstream,
# kept for its simple bot-token setup). Create a Slack app at
# https://api.slack.com/apps with scopes: channels:history, channels:read,
# chat:write, reactions:write, users:read, users.profile:read — then install
# it to the workspace and copy the Bot User OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN="xoxb-..."
# Team ID (starts with T) — Slack workspace → Settings & administration → About.
SLACK_TEAM_ID="T..."
# Optional: comma-separated channel IDs to restrict the server to.
SLACK_CHANNEL_IDS="C..., C..."
