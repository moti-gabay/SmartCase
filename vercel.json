{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["fra1"],

  "functions": {
    "src/app/api/ai/**": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/documents/**": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/**": {
      "maxDuration": 30
    }
  },

  "crons": [
    {
      "path": "/api/ai/transcribe",
      "schedule": "0 9 * * *"
    }
  ],

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
